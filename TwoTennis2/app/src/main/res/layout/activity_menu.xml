<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/bg_menu_arena">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="32dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:text="ENTRE NA ARENA" android:letterSpacing="0.2" android:textSize="11sp" android:textColor="#74C6E8"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="14dp" android:text="TWO" android:gravity="center"
    android:textStyle="bold" android:textSize="52sp" android:letterSpacing="0.12" android:textColor="#8CEBFF"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="TENNIS" android:gravity="center" android:textStyle="bold"
    android:letterSpacing="0.12" android:textSize="42sp" android:textColor="#FF83CF"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:text="Duas raquetes. Uma arena. Caos total."
    android:gravity="center" android:textColor="#B0C4D7" android:textSize="13sp"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="18dp">
   <View android:layout_width="140dp" android:layout_height="9dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/botao_neon_ciano"/>
   <View android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:background="@drawable/bola_menu"/>
   <View android:layout_width="140dp" android:layout_height="9dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/botao_neon_rosa"/>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:padding="18dp" android:background="@drawable/painel_neon_ciano" android:orientation="vertical">
   <TextView android:id="@+id/resumoArena" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center" android:text="CPU NORMAL • META 10" android:textColor="#A7E9FA" android:textSize="12sp"/>
   <Button android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp"
    android:background="@drawable/botao_neon_ciano" android:backgroundTint="@null" android:onClick="btn_iniciar"
    android:text="JOGAR AGORA" android:textColor="#FFFFFF" android:textSize="18sp"/>
   <Button android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
    android:background="@drawable/botao_neon_rosa" android:backgroundTint="@null" android:onClick="btn_configuracoes"
    android:text="CONFIGURAR ARENA" android:textColor="#FFE0F3" android:textSize="14sp"/>
  </LinearLayout>
  <Button android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="10dp"
    android:background="@android:color/transparent" android:onClick="btn_sair" android:text="SAIR" android:textColor="#9FB2C5"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ARENA 1.6"
    android:textSize="10sp" android:letterSpacing="0.15" android:textColor="#697F96"/>
 </LinearLayout>
</ScrollView>