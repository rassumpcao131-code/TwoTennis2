<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5431D7FF" />
            <stroke android:width="2dp" android:color="#BFFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9051526" />
            <stroke android:width="2dp" android:color="#E531D7FF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
